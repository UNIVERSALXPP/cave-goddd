	"license": "MIT",
	"environment": "*",
	"entrypoints": { "main": ["com.mocapaddon.MocapAddon"] },
	"mixins": ["mocap_addon.mixins.json", "mocap_addon.mocap.mixins.json"],
	"depends": {
		"minecraft": ">=1.21.11",
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
